        "command_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "linked_config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "project_ref": {
          "const": "ekdyopdrrkphlrsilyoo"
        },
        "schema_set": {
          "const": [
